# Application Environment
APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=change-me-in-production

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Token Configuration
EMAIL_VERIFY_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sqlanalyst
TARGET_DB_URL=sqlite:///./data/analytics.db

# Security Configuration
DB_MAX_ROWS=10000
DB_ENCRYPTION_KEY=your-encryption-key-here-generate-with-openssl-rand-base64-32

# AI / LLM Configuration
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com

# SMTP Configuration (for email verification & password reset)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sqlanalyst.local

# Default Admin User
DEFAULT_ADMIN_EMAIL=admin@sqlanalyst.com
DEFAULT_ADMIN_PASSWORD=Admin1234
DEFAULT_ADMIN_NAME=Admin