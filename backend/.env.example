# Application Environment
APP_ENV=development
# "development" enables dev-only helpers (OTP shown on screen when email fails,
# Google dev login). Use "production" for any deployed server.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required in production: at least 32 random chars
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Send cookies only over HTTPS (defaults to true when APP_ENV=production)
# COOKIE_SECURE=true

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password-reset link lifetime
PASSWORD_RESET_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sqlanalyst
TARGET_DB_URL=sqlite:///./data/analytics.db

# Security Configuration
DB_MAX_ROWS=10000
# Fernet key used to encrypt saved data-source passwords. Required in production.
# Keep it stable — changing it makes saved passwords unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# AI / LLM Configuration
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=500
LLM_EXPLANATION_TEMPERATURE=0.3
LLM_EXPLANATION_MAX_TOKENS=300

# Redis (query cache) — optional, caching is disabled if unreachable
REDIS_URL=redis://localhost:6379

# Rate limiting on auth endpoints (login, OTP, password reset)
RATE_LIMIT_ENABLED=true

# Let admins run INSERT/UPDATE/DELETE/DDL from the SQL console (write mode).
# Regular users and the AI chat are always read-only.
ADMIN_SQL_WRITES=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Configuration (for email verification & password reset)
SMTP_HOST=
SMTP_PORT=465            # 465 = SSL, 587 = STARTTLS (both work with Gmail)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sqlanalyst.local   # Gmail: use the same address as SMTP_USER
SMTP_TIMEOUT=15
# Test these settings with:  python test_smtp.py you@example.com

# Print every SQL statement the app runs (noisy; for debugging only)
SQL_ECHO=false

# Default Admin User
DEFAULT_ADMIN_EMAIL=admin@sqlanalyst.com
# Change this! The server refuses to start in production with the default.
DEFAULT_ADMIN_PASSWORD=Admin1234
DEFAULT_ADMIN_NAME=Admin